# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Authentication
NEON_AUTH_BASE_URL="https://your-neon-auth-host/neondb/auth"
NEON_AUTH_COOKIE_SECRET="replace-with-at-least-32-characters"

# Gmail OAuth used for password-reset and contact emails
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER="your-gmail-address@example.com"
CONTACT_EMAIL="your-contact-address@example.com"

# Optional Redis
REDIS_URL="redis://localhost:6379"

# Runtime and browser URLs
CORS_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
PORT=3000
NODE_ENV=development